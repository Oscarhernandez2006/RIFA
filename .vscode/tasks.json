{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Boletas: backend",
			"type": "shell",
			"command": "php",
			"args": [
				"artisan",
				"serve",
				"--host=127.0.0.1",
				"--port=8000",
				"--tries=1"
			],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Boletas: frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}